<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- usesCleartextTraffic: release builds speak wss:// on 443 with bundled
         mbedtls anchors and do not need this. It is here for the plain-ws://
         builds (TC_TLS=OFF against the LAN dev server on :3401, and the same
         :80 path the Wii client uses, which has no TLS available at all).
         The protocol carries no credentials - see docs/PROTOCOL.md 7. -->
    <application
        android:allowBackup="false"
        android:hasCode="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true">

        <!-- android.app.NativeActivity is the framework's own class, which is
             why hasCode="false" holds: this APK ships no Java at all. -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode|density"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <!-- loads libtoastchat.so and calls ANativeActivity_onCreate -->
            <meta-data android:name="android.app.lib_name" android:value="toastchat" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
